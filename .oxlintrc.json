{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "import", "jsx-a11y", "nextjs"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "next-env.d.ts",
    "src/components/ui/**",
    "src/hooks/use-mobile.ts"
  ],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "react/display-name": "error",
    "react/no-unescaped-entities": "error",
    "react/rules-of-hooks": "error",
    "typescript/no-explicit-any": "error"
  }
}
